{
  "name": "customer-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:ui": "vite --host 0.0.0.0 --port 5173",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "build": "pnpm build:ui && pnpm typecheck:worker",
    "build:ui": "vite build",
    "cf:types": "wrangler types src/worker/worker-configuration.d.ts",
    "cf:check": "pnpm build:ui && wrangler deploy --dry-run",
    "deploy:cloudflare": "pnpm db:migrate:remote && wrangler deploy --keep-vars",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply customer-service-db --remote",
    "lint": "eslint .",
    "format": "prettier --write src/dashboard/agent-mobile-inbox.css test/agent-mobile-inbox-app-contract.test.mjs && git diff -- src/dashboard/agent-mobile-inbox.css test/agent-mobile-inbox-app-contract.test.mjs && exit 1",
    "format:write": "prettier --write .",
    "preflight": "pnpm format && pnpm lint && pnpm typecheck",
    "verify": "pnpm preflight && pnpm db:migrate:local && pnpm test && pnpm build && pnpm cf:check",
    "smoke:production": "node scripts/smoke-production.mjs",
    "typecheck": "pnpm typecheck:ui && pnpm typecheck:worker",
    "typecheck:ui": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:worker": "pnpm cf:types && tsc -p tsconfig.worker.json --noEmit",
    "test": "node --experimental-strip-types --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "hono": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "wrangler": "^4.123.0"
  }
}
