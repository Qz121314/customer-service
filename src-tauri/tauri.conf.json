{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "客服坐席工作台",
  "version": "1.0.7",
  "identifier": "com.fcqz121314.customer-service-agent",
  "build": {
    "frontendDist": "https://customer-service-app.fcqz121314.workers.dev/agent"
  },
  "app": {
    "windows": [
      {
        "url": "https://customer-service-app.fcqz121314.workers.dev/agent",
        "title": "客服坐席工作台",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
