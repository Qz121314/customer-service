{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "customer-service-app",
  "main": "src/worker/entry.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/client/*",
      "/integration/*",
      "/management/v1",
      "/management/v1/*",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "customer-service-db",
      "migrations_dir": "./migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "customer-service-media",
    },
  ],
  "ratelimits": [
    {
      "name": "CONVERSATION_BURST_LIMITER",
      "namespace_id": "12131401",
      "simple": {
        "limit": 1,
        "period": 60,
      },
    },
    {
      "name": "MEDIA_BURST_LIMITER",
      "namespace_id": "12131402",
      "simple": {
        "limit": 6,
        "period": 60,
      },
    },
    {
      "name": "AUTH_BURST_LIMITER",
      "namespace_id": "12131403",
      "simple": {
        "limit": 20,
        "period": 60,
      },
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONVERSATION_ROOMS",
        "class_name": "ConversationRoom",
      },
    ],
  },
  "exports": {
    "ConversationRoom": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_VERSION": "1.0.0",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
}
